<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StreamGeometry x:Key="CosmoChevronsUpDownGeometry">M7,15 L12,20 L17,15 M7,9 L12,4 L17,9</StreamGeometry>

  <ControlTheme x:Key="CosmoCollapsibleTrigger" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          <Border Name="PART_Toggle" Width="32" Height="32" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <Viewbox Width="16" Height="16">
              <Path Data="{StaticResource CosmoChevronsUpDownGeometry}" Stroke="#0a0a0a" StrokeThickness="2" Width="24" Height="24" />
            </Viewbox>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Toggle">
      <Setter Property="Background" Value="#f5f5f5" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CosmoCollapsible" TargetType="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="8" Background="{TemplateBinding Background}">
          <ToggleButton Name="ExpanderHeader" Theme="{StaticResource CosmoCollapsibleTrigger}" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                        Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" IsEnabled="{TemplateBinding IsEnabled}"
                        Padding="{TemplateBinding Padding}" AutomationProperties.Name="Toggle" />
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            IsVisible="{TemplateBinding IsExpanded}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>

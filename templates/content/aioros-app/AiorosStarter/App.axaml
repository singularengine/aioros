<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AiorosStarter.App">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="32" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.nav">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.nav:pointerover">
      <Setter Property="Background" Value="#14808080" />
    </Style>
  </Application.Styles>
</Application>

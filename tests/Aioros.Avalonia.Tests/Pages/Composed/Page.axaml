<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:v="using:Aioros.Avalonia.Tests.Views"
             xmlns:m="using:Aioros.Avalonia.Tests.Models" x:DataType="m:Article">
  <StackPanel Spacing="4">
    <TextBlock Classes="h1" Text="{Binding Title}" />
    <v:Recent />
    <a:View Source="/Pages/Simple/Page.axaml" />
  </StackPanel>
</UserControl>

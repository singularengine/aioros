<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:g="using:Showcase.Games" xmlns:loader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia" x:DataType="g:StoreModel">
  <StackPanel Spacing="24">
    <Border Classes="g-panel" Padding="14,10" IsVisible="{Binding Seeding}" a:Web.Href="/games/lab">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Classes="g-pulse" VerticalAlignment="Center" />
        <TextBlock Classes="g-blue wrap" Text="{Binding SeedText}" VerticalAlignment="Center" />
        <TextBlock Classes="g-white small" Text="Watch it live →" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Classes="g-card g-rise" a:Web.Href="{Binding Featured.Href}" IsVisible="{Binding HasFeatured}" Height="300">
      <Grid ColumnDefinitions="3*,2*" a:Web.StackBelow="860">
        <Border Classes="g-cover" MinHeight="220">
          <Image loader:ImageLoader.Source="{Binding Featured.Art}" AutomationProperties.Name="{Binding Featured.Title}" Stretch="UniformToFill" Height="300" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="12" Margin="28,26" VerticalAlignment="Center">
          <TextBlock Classes="g-blue small" Text="FEATURED &amp; RECOMMENDED" FontWeight="Bold" />
          <TextBlock Classes="g-hero" Text="{Binding Featured.Title}" />
          <TextBlock Classes="g-muted" Text="{Binding Featured.Studio}" />
          <TextBlock Classes="small" Text="{Binding Featured.Tags}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Featured.Rating}" Foreground="{Binding Featured.RatingColor}" FontWeight="SemiBold" />
            <TextBlock Classes="g-muted" Text="{Binding Featured.Owners}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="g-off" IsVisible="{Binding Featured.OnSale}"><TextBlock Text="{Binding Featured.Off}" FontSize="18" /></Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="g-strike" Text="{Binding Featured.Original}" IsVisible="{Binding Featured.OnSale}" />
              <TextBlock Classes="g-white" Text="{Binding Featured.Price}" FontSize="18" FontWeight="Bold" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Spacing="12">
      <TextBlock Classes="g-head" Text="Special offers" />
      <ItemsControl ItemsSource="{Binding Offers}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" ColumnSpacing="14" a:Web.StackBelow="760" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="g:GameCard">
            <Border Classes="g-card" a:Web.Href="{Binding Href}">
              <StackPanel>
                <Border Classes="g-cover" Height="110">
                  <Image loader:ImageLoader.Source="{Binding Art}" AutomationProperties.Name="{Binding Title}" Stretch="UniformToFill" Height="110" />
                </Border>
                <Grid ColumnDefinitions="*,Auto" Margin="12,10">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="g-white" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="g-muted small" Text="{Binding Rating}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Classes="g-off"><TextBlock Classes="small" Text="{Binding Off}" /></Border>
                    <TextBlock Classes="g-green" Text="{Binding Price}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto" a:Web.StackBelow="760">
      <StackPanel Spacing="4">
        <TextBlock Classes="g-head" Text="Browse the store" />
        <TextBlock Classes="g-muted small" Text="{Binding Summary}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBox Text="{Binding Search}" PlaceholderText="Search titles and studios" Width="260" />
        <Button Classes="g-quiet" Command="{Binding FindCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6"><a:Icon Kind="search" Size="15" VerticalAlignment="Center" /><TextBlock Text="Search" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ItemsControl ItemsSource="{Binding GenreLinks}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="g:ChipLink">
          <Panel>
            <Border Classes="g-chip on" a:Web.Href="{Binding Href}" IsVisible="{Binding Current}">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="small" Text="{Binding Label}" FontWeight="SemiBold" /><TextBlock Classes="small" Text="{Binding Count}" Opacity="0.7" /></StackPanel>
            </Border>
            <Border Classes="g-chip" a:Web.Href="{Binding Href}" IsVisible="{Binding !Current}">
              <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Classes="small" Text="{Binding Label}" /><TextBlock Classes="small g-muted" Text="{Binding Count}" /></StackPanel>
            </Border>
          </Panel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" Spacing="6">
      <TextBlock Classes="g-muted small" Text="Sort by" VerticalAlignment="Center" Margin="0,0,4,0" />
      <ItemsControl ItemsSource="{Binding SortLinks}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="g:ChipLink">
            <Panel>
              <Border Classes="g-tab on" a:Web.Href="{Binding Href}" IsVisible="{Binding Current}" Padding="10,5"><TextBlock Classes="small" Text="{Binding Label}" FontWeight="SemiBold" /></Border>
              <Border Classes="g-tab" a:Web.Href="{Binding Href}" IsVisible="{Binding !Current}" Padding="10,5"><TextBlock Classes="small" Text="{Binding Label}" /></Border>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Games}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" ColumnSpacing="16" RowSpacing="16" a:Web.StackBelow="760" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="g:GameCard">
          <Border Classes="g-card" a:Web.Href="{Binding Href}">
            <StackPanel>
              <Border Classes="g-cover" Height="130">
                <Image loader:ImageLoader.Source="{Binding Art}" AutomationProperties.Name="{Binding Title}" Stretch="UniformToFill" Height="130" />
              </Border>
              <StackPanel Spacing="6" Margin="14,12,14,14">
                <TextBlock Classes="g-white" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="g-muted small" Text="{Binding Studio}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Classes="g-tag"><TextBlock Text="{Binding Genre}" /></Border>
                  <TextBlock Classes="small" Text="{Binding Rating}" Foreground="{Binding RatingColor}" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <TextBlock Classes="g-muted small" Text="{Binding Owners}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Border Classes="g-off" IsVisible="{Binding OnSale}"><TextBlock Classes="small" Text="{Binding Off}" /></Border>
                    <TextBlock Classes="g-white" Text="{Binding Price}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border Classes="g-panel" IsVisible="{Binding Empty}" Padding="20,40">
      <TextBlock Classes="g-muted" Text="No games match. Try another genre or search." HorizontalAlignment="Center" />
    </Border>

    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <a:Icon Kind="zap" Size="14" Foreground="#66C0F4" VerticalAlignment="Center" />
        <TextBlock Classes="g-muted small" Text="{Binding Parallel}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="g-muted small" Text="{Binding PageText}" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Classes="g-pager" a:Web.Href="{Binding PreviousHref}" IsVisible="{Binding HasPrevious}">
          <StackPanel Orientation="Horizontal" Spacing="4"><a:Icon Kind="chevron-left" Size="16" Foreground="#C7D5E0" VerticalAlignment="Center" /><TextBlock Text="Previous" /></StackPanel>
        </Border>
        <Border Classes="g-pager" a:Web.Href="{Binding NextHref}" IsVisible="{Binding HasNext}">
          <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Next" /><a:Icon Kind="chevron-right" Size="16" Foreground="#C7D5E0" VerticalAlignment="Center" /></StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>

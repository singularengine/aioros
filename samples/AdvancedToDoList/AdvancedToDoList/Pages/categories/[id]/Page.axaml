<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SharedControls.Controls;assembly=SharedControls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:a="https://aioros.dev"
             xmlns:viewModels="clr-namespace:AdvancedToDoList.ViewModels"
             d:DesignHeight="450"
             MinWidth="350"
             a:Page.Title="Edit category"
             x:DataType="viewModels:EditCategoryViewModel"
             mc:Ignorable="d">

    <Grid Margin="10"
          RowDefinitions="Auto, *, Auto"
          RowSpacing="10">
        <!-- The overlay dialog's header -->
        <TextBlock Classes="h1" Text="Edit category" />
        <ScrollViewer Grid.Row="1"
                      DataContext="{Binding Item}">
            <StackPanel Grid.IsSharedSizeScope="True" Spacing="5">
                <!--  ID  -->
                <controls:LabeledControl Header="ID">
                    <TextBox IsReadOnly="True"
                             Text="{Binding Id, Mode=OneWay}"
                             PlaceholderText="The ID will be set after saving automatically." />
                </controls:LabeledControl>

                <!--  Name  -->
                <controls:LabeledControl Header="Name">
                    <TextBox x:Name="NameTextBox" Text="{Binding Name}" PlaceholderText="The display name of the Group" />
                </controls:LabeledControl>

                <!--  Description  -->
                <controls:LabeledControl Header="Description">
                    <TextBox x:Name="DescriptionTextBox" Text="{Binding Description}" />
                </controls:LabeledControl>

                <!--  Group Color  -->
                <controls:LabeledControl Header="Color">
                    <Panel>
                        <ColorPicker HorizontalAlignment="Left"
                                     IsAlphaEnabled="False"
                                     IsAlphaVisible="False"
                                     IsVisible="{a:OnPlatform Default=True, Web=False}"
                                     Color="{Binding Color}" />
                        <!-- The web has no ColorPicker yet: the color as text -->
                        <TextBox IsVisible="{a:OnPlatform Default=False, Web=True}" Text="{Binding ColorText}" />
                    </Panel>
                </controls:LabeledControl>

                <Separator />

                <controls:LabeledControl Header="Preview">
                    <ContentControl Content="{Binding}" />
                </controls:LabeledControl>
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Right"
                   ItemSpacing="5"
                   Orientation="Horizontal">
            <!-- The error dialogs, as a message -->
            <TextBlock Text="{Binding Error}" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <!-- The "Save changes?" dialog, as the Cancel button's flyout -->
            <Button x:Name="CancelButton" Content="Cancel">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="10" MaxWidth="300">
                            <TextBlock FontWeight="Bold" Text="Save changes?" />
                            <TextBlock Text="Do you want to save the changes before closing this dialog?" />
                            <WrapPanel HorizontalAlignment="Right" ItemSpacing="5">
                                <Button Command="{Binding SaveCommand}" Content="Yes" />
                                <Button Command="{Binding CancelCommand}" Content="No" />
                            </WrapPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="SaveButton" Command="{Binding SaveCommand}" Content="Save" />
        </WrapPanel>
    </Grid>

</UserControl>

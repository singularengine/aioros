<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Aioros.Targets.Desktop.Tests.Views" xmlns:m="using:Aioros.Targets.Desktop.Tests.Navigation" x:DataType="m:Saving">
  <StackPanel>
    <TextBlock Text="{Binding Label}" />
    <Button Content="Page save" Command="{Binding SaveCommand}" />
    <v:Saver />
    <v:Saver />
  </StackPanel>
</UserControl>

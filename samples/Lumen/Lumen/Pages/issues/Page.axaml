<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.ViewModels"
             xmlns:data="using:Lumen.Data"
             xmlns:a="https://aioros.dev"
             x:DataType="vm:IssuesViewModel">
    <StackPanel>
      <Border Padding="16,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Border Classes="pill" Background="{DynamicResource Chip}"><TextBlock Classes="small" Text="All" /></Border>
            <Border Classes="pill"><TextBlock Classes="small muted" Text="Active" /></Border>
            <Border Classes="pill"><TextBlock Classes="small muted" Text="Backlog" /></Border>
            <TextBlock Classes="faint small" Text="{Binding Summary}" VerticalAlignment="Center" Margin="6,0,0,0" a:Web.HideBelow="640" />
          </StackPanel>
          <Border Grid.Column="1" Classes="btn" a:Web.Href="/issues/LUM-101">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <a:Icon Kind="plus" Size="14" VerticalAlignment="Center" />
              <TextBlock Text="New issue" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:IssueGroup">
            <StackPanel>
              <Border Classes="group">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <a:Icon Kind="{Binding Icon}" Foreground="{Binding Color}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Classes="faint" Text="{Binding Count}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="data:Issue">
                    <Border Classes="row" a:Web.Href="{Binding Href}">
                      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                        <a:Icon Kind="{Binding PriorityIcon}" Foreground="{Binding PriorityColor}" Size="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="faint" Text="{Binding Id}" VerticalAlignment="Center" a:Web.HideBelow="480" />
                        <a:Icon Grid.Column="2" Kind="{Binding StatusIcon}" Foreground="{Binding StatusColor}" Size="14" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <ItemsControl Grid.Column="4" ItemsSource="{Binding Labels}" VerticalAlignment="Center" a:Web.HideBelow="820">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="data:Label">
                              <Border Classes="pill">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <Border Classes="dot" Background="{Binding Color}" VerticalAlignment="Center" />
                                  <TextBlock Classes="small muted" Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Grid.Column="5" Classes="avatar" Background="{Binding Assignee.Color}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Assignee.Initials}" />
                        </Border>
                        <TextBlock Grid.Column="6" Classes="faint small" Text="{Binding UpdatedText}" VerticalAlignment="Center" a:Web.HideBelow="640" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
</UserControl>

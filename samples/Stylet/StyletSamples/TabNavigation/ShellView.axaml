<UserControl
    x:Class="Stylet.Samples.TabNavigation.ShellView"
    x:DataType="local:ShellViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="using:Stylet.Avalonia"
    xmlns:local="using:Stylet.Samples.TabNavigation"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.DataTemplates>
        <DataTemplate DataType="local:Page1ViewModel"><local:Page1View /></DataTemplate>
        <DataTemplate DataType="local:Page2ViewModel"><local:Page2View /></DataTemplate>
    </UserControl.DataTemplates>
    <UserControl.Styles>
        <Style Selector="TabControl.StyletConductorTabControl">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate x:DataType="s:IScreen">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentControl
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{Binding}"
                            IsTabStop="False" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ActiveItem.DisplayName, StringFormat='Active page is {0}'}" />
        <TabControl
            Margin="0,10,0,0"
            Classes="StyletConductorTabControl"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding ActiveItem}" />
    </DockPanel>
</UserControl>

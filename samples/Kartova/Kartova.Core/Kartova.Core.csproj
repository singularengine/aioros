<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Kartova.Core</RootNamespace>
    <AssemblyName>Kartova.Core</AssemblyName>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AiorosHost>true</AiorosHost>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kartova.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- XxHash128 for duplicate detection. First-party, MIT, and roughly an order of
         magnitude faster than the built-in cryptographic hashes, which matters when the
         job is reading gigabytes off disk. -->
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

</Project>

<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Aioros.Avalonia.Tests.Models" x:Class="Aioros.Avalonia.Tests.Views.Reaching" x:DataType="m:Brand">
  <StackPanel>
    <TextBlock Text="{Binding Name}" />
    <TextBlock Text="{Binding $parent[UserControl;1].((m:Article)DataContext).Title}" />
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="using:Aioros.Targets.Desktop.Tests.Navigation" x:DataType="m:Later">
  <StackPanel>
    <Button Content="Send" Command="{Binding SendCommand}" />
    <Button Content="Break" Command="{Binding BreakCommand}" />
  </StackPanel>
</UserControl>

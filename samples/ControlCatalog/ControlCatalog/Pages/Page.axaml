<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" a:Page.Title="Avalonia ControlCatalog">
  <StackPanel Margin="20" Spacing="8">
    <TextBlock Classes="h1" Text="Avalonia ControlCatalog pages, ported to Aioros" />
    <TextBlock Classes="h2" Text="From AvaloniaUI/Avalonia 12.1.3, samples/ControlCatalog (MIT)." />
    <HyperlinkButton NavigateUri="/border" Content="Border" />
    <HyperlinkButton NavigateUri="/relativepanel" Content="RelativePanel" />
    <HyperlinkButton NavigateUri="/textblock" Content="TextBlock" />
  </StackPanel>
</UserControl>

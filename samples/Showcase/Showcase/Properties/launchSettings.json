{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Showcase": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5317",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "Showcase (desktop)": {
      "commandName": "Project",
      "commandLineArgs": "--desktop",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development" }
    },
    "Showcase (remote desktop)": {
      "commandName": "Project",
      "commandLineArgs": "--desktop",
      "environmentVariables": { "ASPNETCORE_ENVIRONMENT": "Development", "Aioros__Server": "http://localhost:5317" }
    }
  }
}

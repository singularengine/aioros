<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:g="using:Showcase.Games" xmlns:loader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia" x:DataType="g:LibraryModel">
  <StackPanel Spacing="18">
    <StackPanel Spacing="4">
      <TextBlock Classes="g-hero" Text="Your library" />
      <TextBlock Classes="g-muted" Text="{Binding Summary}" />
    </StackPanel>
    <Border Classes="g-panel" IsVisible="{Binding Empty}" Padding="20,40">
      <TextBlock Classes="g-muted" Text="Nothing here yet. Buy a game in the store." HorizontalAlignment="Center" />
    </Border>
    <ItemsControl ItemsSource="{Binding Entries}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="g:LibraryEntry">
          <Border Classes="g-card" a:Web.Href="{Binding Game.Href}">
            <Grid ColumnDefinitions="200,*,Auto">
              <Border Classes="g-cover" Height="96">
                <Image loader:ImageLoader.Source="{Binding Game.Art}" AutomationProperties.Name="{Binding Game.Title}" Stretch="UniformToFill" Height="96" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="18,0" VerticalAlignment="Center">
                <TextBlock Classes="g-white" Text="{Binding Game.Title}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Classes="g-muted small" Text="{Binding Game.Studio}" />
                <TextBlock Classes="small" Text="{Binding Bought}" />
              </StackPanel>
              <Border Grid.Column="2" Classes="g-buy" Margin="0,0,18,0" VerticalAlignment="Center" a:Web.HideBelow="640">
                <StackPanel Orientation="Horizontal" Spacing="8"><a:Icon Kind="play" Size="15" VerticalAlignment="Center" /><TextBlock Text="Play" /></StackPanel>
              </Border>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview.1</VersionSuffix>
    <Authors>Aioros contributors</Authors>
    <Description>Aioros, the XAML framework for web and native apps: web, desktop and mobile apps from one XAML and C# codebase, server-rendered to HTML and CSS.</Description>
    <RepositoryUrl>https://github.com/singularengine/aioros.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/singularengine/aioros</PackageProjectUrl>
    <PackageTags>avalonia;xaml;mvvm;ssr;web;framework</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../artifacts/packages</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Concurrency.txt" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>

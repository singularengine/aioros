<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Thickness x:Key="TableViewRowPadding">0</Thickness>
  <Thickness x:Key="TableViewCellPadding">8</Thickness>
  <SolidColorBrush x:Key="TableViewColumnHeaderSeparatorBackground" Color="Transparent" />

  <ControlTheme x:Key="CosmoTableScrollViewer" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <DockPanel>
            <Border Name="PART_Header" DockPanel.Dock="Top" BorderBrush="#e5e5e5" BorderThickness="0,0,0,1">
              <TableViewColumnHeadersPresenter />
            </Border>
            <ScrollContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" />
          </DockPanel>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TableView}" TargetType="TableView">
    <Setter Property="Foreground" Value="#0a0a0a" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <ScrollViewer Name="PART_ScrollViewer" Theme="{StaticResource CosmoTableScrollViewer}">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="{TemplateBinding Padding}" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TableViewColumnHeader}" TargetType="TableViewColumnHeader">
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="#0a0a0a" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Height" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" ContentTemplate="{TemplateBinding ContentTemplate}"
                          Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" TextBlock.LineHeight="20"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TableViewRow}" TargetType="TableViewRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#e5e5e5" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <TableViewCellsPresenter Name="PART_CellsPresenter" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:nth-last-child(1)">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Border">
      <Setter Property="Background" Value="#80f5f5f5" />
    </Style>
    <Style Selector="^:selected /template/ Border#Border">
      <Setter Property="Background" Value="#f5f5f5" />
    </Style>
    <Style Selector="^.selected /template/ Border#Border">
      <Setter Property="Background" Value="#f5f5f5" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TableViewCell}" TargetType="TableViewCell">
    <Setter Property="Padding" Value="8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextBlock.LineHeight" Value="20" />
  </ControlTheme>
</ResourceDictionary>

<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:a="https://aioros.dev">
  <StackPanel>
    <TextBlock Text="{a:OnPlatform Default=default, Windows=windows, macOS=macos, Linux=linux, Web=web}" />
    <TextBlock Text="{a:OnPlatform Default=fallback, Web=web}" />
  </StackPanel>
</UserControl>

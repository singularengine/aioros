<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m="using:Aioros.Avalonia.Tests.Models" xmlns:a="https://aioros.dev">
  <StreamGeometry x:Key="CosmoLucideSearchGeometry">M3,11 A8,8 0 1 1 19,11 A8,8 0 1 1 3,11 Z M21,21 L16.7,16.7</StreamGeometry>
  <StreamGeometry x:Key="CosmoLucideCheckGeometry">M20,6 L9,17 L4,12</StreamGeometry>
  <StreamGeometry x:Key="CosmoLucideChevronsUpDownGeometry">M7,15 L12,20 L17,15 M7,9 L12,4 L17,9</StreamGeometry>

  <ControlTheme x:Key="CosmoCommandInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Style Selector="^ /template/ Border#PART_BorderElement">
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:focus /template/ Border#PART_BorderElement">
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type m:Finder}" TargetType="m:Finder">
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#0a0a0a" />
    <Setter Property="BorderBrush" Value="#e5e5e5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <m:FinderPanel />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <Border Name="PART_Clip" ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
            <DockPanel>
              <Border Name="PART_InputWrapper" DockPanel.Dock="Top" Height="36" Padding="12,0" BorderThickness="0,0,0,1"
                      BorderBrush="#e5e5e5">
                <DockPanel>
                  <Viewbox Name="PART_SearchIcon" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" Opacity="0.5" VerticalAlignment="Center">
                    <Path StrokeThickness="2" Stroke="{TemplateBinding Foreground}" Data="{StaticResource CosmoLucideSearchGeometry}" />
                  </Viewbox>
                  <TextBox Name="PART_Input" a:Web.Filter="Input" Theme="{StaticResource CosmoCommandInput}" Height="40" VerticalAlignment="Center"
                           Text="{TemplateBinding Text, Mode=TwoWay}" PlaceholderText="{TemplateBinding Placeholder}"
                           AutomationProperties.Name="{TemplateBinding Placeholder}" />
                </DockPanel>
              </Border>
              <Panel>
                <ContentPresenter Name="PART_Empty" a:Web.Filter="Empty" Content="{TemplateBinding Empty}" IsVisible="{TemplateBinding IsEmpty}"
                                  Padding="0,24" HorizontalContentAlignment="Center" TextBlock.LineHeight="20" />
                <ScrollViewer Name="PART_List" MaxHeight="300" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                             >
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Panel>
            </DockPanel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.outline">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="^.outline /template/ Border#PART_Root">
      <Setter Property="BoxShadow" Value="0 4 6 -1 #1a000000" />
    </Style>
    <Style Selector="^.dialog /template/ Border#PART_InputWrapper">
      <Setter Property="Height" Value="48" />
    </Style>
    <Style Selector="^.dialog /template/ TextBox#PART_Input">
      <Setter Property="Height" Value="48" />
    </Style>
    <Style Selector="^.dialog /template/ Viewbox#PART_SearchIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="^.combobox /template/ TextBox#PART_Input">
      <Setter Property="Height" Value="36" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type m:FinderGroup}" TargetType="m:FinderGroup">
    <Setter Property="Foreground" Value="#0a0a0a" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <m:FinderPanel />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Margin="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_Header" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Padding="8,6" FontSize="12" FontWeight="Medium" TextBlock.LineHeight="16"
                            Foreground="#737373"
                            IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type m:FinderItem}" TargetType="m:FinderItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#0a0a0a" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <DockPanel>
            <Viewbox Name="PART_Check" DockPanel.Dock="Right" Width="16" Height="16" Margin="8,0,0,0" IsVisible="False" Opacity="0" VerticalAlignment="Center">
              <Path StrokeThickness="2" Stroke="{TemplateBinding Foreground}" Data="{StaticResource CosmoLucideCheckGeometry}" />
            </Viewbox>
            <TextBlock Name="PART_Shortcut" DockPanel.Dock="Right" Text="{TemplateBinding Shortcut}" Margin="8,0,0,0" FontSize="12" LineHeight="16"
                       LetterSpacing="1.2" VerticalAlignment="Center" Foreground="#737373"
                       IsVisible="{TemplateBinding Shortcut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" TextBlock.LineHeight="20"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="#f5f5f5" />
      <Setter Property="Foreground" Value="#171717" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="^:checkable /template/ Viewbox#PART_Check">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked /template/ Viewbox#PART_Check">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type m:FinderSeparator}" TargetType="m:FinderSeparator">
    <Setter Property="Background" Value="#e5e5e5" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type m:Picker}" TargetType="m:Picker">
    <Setter Property="Width" Value="200" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Button Name="PART_Trigger" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{TemplateBinding PlaceholderText}">
          <DockPanel>
            <Viewbox DockPanel.Dock="Right" Width="16" Height="16" Opacity="0.5" Margin="8,0,0,0" VerticalAlignment="Center">
              <Path StrokeThickness="2" Stroke="{Binding $parent[Button].Foreground}" Data="{StaticResource CosmoLucideChevronsUpDownGeometry}" />
            </Viewbox>
            <Panel ClipToBounds="True" a:Web.ShowsChoice="True">
              <TextBlock Name="PART_Placeholder" Text="{TemplateBinding PlaceholderText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <ContentPresenter Name="PART_Selection" Content="{TemplateBinding SelectedItem}" ContentTemplate="{TemplateBinding SelectionTemplate}"
                                VerticalAlignment="Center" IsVisible="False" />
              <ItemsControl Name="PART_Chosen" ItemsSource="{TemplateBinding SelectedItems}" ItemTemplate="{TemplateBinding SelectionTemplate}" IsVisible="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerTheme>
                  <ControlTheme TargetType="ContentPresenter">
                    <Setter Property="Background" Value="#f5f5f5" />
                    <Setter Property="Foreground" Value="#171717" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Height" Value="20" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                  </ControlTheme>
                </ItemsControl.ItemContainerTheme>
              </ItemsControl>
            </Panel>
          </DockPanel>
        </Button>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:chosen /template/ TextBlock#PART_Placeholder">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:chosen:not(:multiple) /template/ ContentPresenter#PART_Selection">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:chosen:multiple /template/ ItemsControl#PART_Chosen">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>

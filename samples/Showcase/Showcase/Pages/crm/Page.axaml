<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:m="using:Showcase.Models" x:DataType="m:CrmModel">
  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row:pointerover"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="Border.row:pointerover TextBlock.name"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Border.sort">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.sort:pointerover"><Setter Property="Background" Value="{DynamicResource Hover}" /></Style>
    <Style Selector="Border.sort.on"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></Style>
    <Style Selector="Border.sort.on TextBlock"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Border.plan">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="18">
    <Grid ColumnDefinitions="*,Auto" a:Web.StackBelow="800">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Customers" />
        <TextBlock Classes="muted" Text="{Binding Summary}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBox Text="{Binding Search}" PlaceholderText="Search name, company or email" Width="260" />
        <Button Classes="accent" Content="Search" Command="{Binding FindCommand}" />
      </StackPanel>
    </Grid>

    <Border Classes="card" Padding="12,10" IsVisible="{Binding Saved}" BorderBrush="{DynamicResource Positive}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <a:Icon Kind="check" Size="16" Foreground="{DynamicResource Positive}" VerticalAlignment="Center" />
        <TextBlock Text="Changes saved." VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="4">
      <TextBlock Classes="muted small" Text="Sort by" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ItemsControl ItemsSource="{Binding SortLinks}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:SortLink">
            <Panel>
              <Border Classes="sort on" a:Web.Href="{Binding Href}" IsVisible="{Binding Current}">
                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="small" Text="{Binding Label}" FontWeight="SemiBold" /><TextBlock Classes="small" Text="{Binding Mark}" /></StackPanel>
              </Border>
              <Border Classes="sort" a:Web.Href="{Binding Href}" IsVisible="{Binding !Current}">
                <TextBlock Classes="small muted" Text="{Binding Label}" />
              </Border>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Border Classes="card" Padding="0">
      <StackPanel>
        <Border Padding="16,10" a:Web.HideBelow="760">
          <Grid ColumnDefinitions="2*,2*,1.4*,*,*,*">
            <TextBlock Classes="muted small" Text="Name" />
            <TextBlock Grid.Column="1" Classes="muted small" Text="Company" />
            <TextBlock Grid.Column="2" Classes="muted small" Text="Country" />
            <TextBlock Grid.Column="3" Classes="muted small" Text="Plan" />
            <TextBlock Grid.Column="4" Classes="muted small" Text="Revenue" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="5" Classes="muted small" Text="Since" HorizontalAlignment="Right" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:CustomerRow">
              <Border Classes="row" a:Web.Href="{Binding Href}">
                <Grid ColumnDefinitions="2*,2*,1.4*,*,*,*" a:Web.StackBelow="760">
                  <StackPanel Spacing="1">
                    <TextBlock Classes="name" Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted small" Text="{Binding Email}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Company}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Country}" VerticalAlignment="Center" a:Web.HideBelow="760" />
                  <Border Grid.Column="3" Classes="plan" VerticalAlignment="Center"><TextBlock Classes="small" Text="{Binding Plan}" /></Border>
                  <TextBlock Grid.Column="4" Text="{Binding Revenue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Classes="muted" Text="{Binding Since}" HorizontalAlignment="Right" VerticalAlignment="Center" a:Web.HideBelow="760" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Padding="16,40" IsVisible="{Binding Empty}">
          <TextBlock Classes="muted" Text="No customers match your search." HorizontalAlignment="Center" />
        </Border>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Classes="muted small" Text="{Binding PageText}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Border Classes="pager" a:Web.Href="{Binding PreviousHref}" IsVisible="{Binding HasPrevious}">
          <StackPanel Orientation="Horizontal" Spacing="4"><a:Icon Kind="chevron-left" Size="16" VerticalAlignment="Center" /><TextBlock Text="Previous" /></StackPanel>
        </Border>
        <Border Classes="pager" a:Web.Href="{Binding NextHref}" IsVisible="{Binding HasNext}">
          <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Next" /><a:Icon Kind="chevron-right" Size="16" VerticalAlignment="Center" /></StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Expander Classes="source" Header="View the XAML of this page">
      <Border Classes="code"><SelectableTextBlock Classes="source" Text="{Binding Xaml}" /></Border>
    </Expander>
  </StackPanel>
</UserControl>

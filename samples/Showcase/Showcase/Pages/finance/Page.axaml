<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:m="using:Showcase.Models" x:DataType="m:FinanceModel" a:Web.Live="True">
  <UserControl.Styles>
    <Style Selector="Border.live">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Background" Value="{DynamicResource Positive}" />
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="0,10" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="20">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Markets" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Classes="live" VerticalAlignment="Center" />
          <TextBlock Classes="muted small" Text="{Binding Updated}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" a:Web.StackBelow="900">
      <Border Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="6">
            <TextBlock Classes="muted small" Text="Portfolio value" />
            <TextBlock Classes="figure" Text="{Binding Value}" />
            <TextBlock Classes="small" Text="{Binding DayChange}" Foreground="{DynamicResource Positive}" />
          </StackPanel>
          <a:Chart Grid.Column="1" Title="Portfolio value" ShowAxes="False" Width="120" Height="48" VerticalAlignment="Center">
            <a:ChartSeries Kind="Area" ItemsSource="{Binding Portfolio}" XPath="At" YPath="Value" Stroke="#5B5BD6" StrokeThickness="1.5" />
          </a:Chart>
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="muted small" Text="Cash available" />
          <TextBlock Classes="figure" Text="{Binding Cash}" />
          <TextBlock Classes="muted small" Text="Settled today" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card">
        <StackPanel Spacing="6">
          <TextBlock Classes="muted small" Text="Positions" />
          <TextBlock Classes="figure" Text="{Binding Positions}" />
          <TextBlock Classes="muted small" Text="Across 4 sectors" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" a:Web.StackBelow="640">
          <StackPanel Spacing="2">
            <TextBlock Classes="muted small" Text="AIOR · Aioros Inc." />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="figure" Text="{Binding Price}" />
              <TextBlock Classes="up" Text="{Binding Change}" IsVisible="{Binding Up}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
              <TextBlock Classes="down" Text="{Binding Change}" IsVisible="{Binding Down}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="10" Height="3" Background="#5B5BD6" VerticalAlignment="Center" /><TextBlock Classes="muted small" Text="Price" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="10" Height="3" Background="#F2994A" VerticalAlignment="Center" /><TextBlock Classes="muted small" Text="15-minute average" /></StackPanel>
          </StackPanel>
        </Grid>
        <a:Chart Title="Aioros Inc. price, live" Height="260">
          <a:ChartSeries Kind="Area" ItemsSource="{Binding Prices}" XPath="At" YPath="Value" Stroke="#5B5BD6" />
          <a:ChartSeries Kind="Line" ItemsSource="{Binding Average}" XPath="At" YPath="Value" Stroke="#F2994A" StrokeThickness="1.5" />
        </a:Chart>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="2*,*" ColumnSpacing="16" a:Web.StackBelow="900">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Last 40 sessions" />
          <a:Chart Title="Daily candlesticks" Height="240">
            <a:ChartSeries Kind="Candle" ItemsSource="{Binding Candles}" XPath="Day" OpenPath="Open" HighPath="High" LowPath="Low" YPath="Close" Fill="#3DB27A" Stroke="#E5484D" />
          </a:Chart>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="Allocation" />
          <a:Chart Title="Portfolio allocation by sector" Height="240">
            <a:ChartSeries Kind="Donut" ItemsSource="{Binding Allocation}" XPath="Name" YPath="Weight" />
          </a:Chart>
        </StackPanel>
      </Border>
    </Grid>

    <Grid ColumnDefinitions="2*,*" ColumnSpacing="16" a:Web.StackBelow="900">
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" Text="Watchlist" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Watchlist}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:Quote">
                <Border Classes="row">
                  <Grid ColumnDefinitions="64,*,Auto,90,76">
                    <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <a:Chart Grid.Column="2" Title="{Binding Symbol}" ShowAxes="False" Width="110" Height="28" Margin="8,0" VerticalAlignment="Center" a:Web.HideBelow="600">
                      <a:ChartSeries Kind="Line" ItemsSource="{Binding History}" XPath="At" YPath="Value" Stroke="#8183F4" StrokeThickness="1.5" />
                    </a:Chart>
                    <TextBlock Grid.Column="3" Text="{Binding Price}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Classes="up" Text="{Binding Change}" IsVisible="{Binding Up}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Classes="down" Text="{Binding Change}" IsVisible="{Binding !Up}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Classes="h2" Text="Recent trades" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Trades}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:Trade">
                <Border Classes="row">
                  <Grid ColumnDefinitions="48,*,Auto">
                    <TextBlock Classes="muted small" Text="{Binding Time}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="up" Text="{Binding Side}" IsVisible="{Binding Buy}" FontWeight="SemiBold" />
                      <TextBlock Classes="down" Text="{Binding Side}" IsVisible="{Binding !Buy}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Size}" />
                      <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Price}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <Expander Classes="source" Header="View the XAML of this page">
      <Border Classes="code"><SelectableTextBlock Classes="source" Text="{Binding Xaml}" /></Border>
    </Expander>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lumen.ViewModels"
             xmlns:data="using:Lumen.Data"
             xmlns:a="https://aioros.dev"
             x:DataType="vm:InboxViewModel">
    <StackPanel>
      <Border Padding="16,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="h2" Text="Notifications" VerticalAlignment="Center" />
          <Border Classes="count" VerticalAlignment="Center"><TextBlock Text="{Binding Summary}" /></Border>
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="data:Notification">
            <Border Classes="row enter" a:Web.Href="{Binding Href}">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" IsVisible="{Binding Unread}" />
                <Border Grid.Column="1" Classes="avatar" Background="{Binding Who.Color}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Who.Initials}" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Who.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" Text="{Binding Issue.Id}" a:Web.HideBelow="520" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <a:Icon Kind="{Binding Issue.StatusIcon}" Foreground="{Binding Issue.StatusColor}" Size="12" VerticalAlignment="Center" />
                    <TextBlock Classes="muted small" Text="{Binding Issue.Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <a:Icon Kind="{Binding Icon}" Foreground="{Binding Color}" Size="14" VerticalAlignment="Center" a:Web.HideBelow="520" />
                  <TextBlock Classes="faint small" Text="{Binding Time}" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
</UserControl>

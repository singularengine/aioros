<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:g="using:Showcase.Games" x:DataType="g:AccountModel">
  <StackPanel Spacing="18">
    <StackPanel Spacing="4">
      <TextBlock Classes="g-hero" Text="Your account" />
      <TextBlock Classes="g-muted" Text="{Binding UserName}" />
    </StackPanel>
    <StackPanel Spacing="10">
      <TextBlock Classes="g-white" Text="Installed apps" FontWeight="SemiBold" FontSize="16" />
      <TextBlock Classes="g-muted small" Text="The desktop apps signed in as you. Signing one out ends its session at once; it asks to sign in again." TextWrapping="Wrap" />
      <Border Classes="g-panel" IsVisible="{Binding Empty}" Padding="20,30">
        <TextBlock Classes="g-muted" Text="No installed app is signed in as you." HorizontalAlignment="Center" />
      </Border>
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="g:DeviceRow">
            <Border Classes="g-panel" Padding="16,12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <a:Icon Kind="monitor" Size="20" Foreground="#66C0F4" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" Margin="14,0" VerticalAlignment="Center">
                  <TextBlock Classes="g-white" Text="{Binding Device}" FontWeight="SemiBold" />
                  <TextBlock Classes="g-muted small" Text="{Binding Signed}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="g-quiet" Command="{Binding $parent[UserControl].((g:AccountModel)DataContext).RevokeCommand}" CommandParameter="{Binding Id}" AutomationProperties.Name="Sign out this app" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6"><a:Icon Kind="log-out" Size="15" VerticalAlignment="Center" /><TextBlock Text="Sign out" /></StackPanel>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" a:Page.Title="AiorosStarter" a:Page.TitleTemplate="%s · AiorosStarter">
  <StackPanel>
    <Border Padding="24,14" BorderThickness="0,0,0,1" BorderBrush="#26808080">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="AiorosStarter" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Border Classes="nav" a:Web.Href="/"><TextBlock Text="Home" /></Border>
        <Border Classes="nav" a:Web.Href="/about"><TextBlock Text="About" /></Border>
        <HyperlinkButton NavigateUri="/theme/toggle" Content="Theme" />
      </StackPanel>
    </Border>
    <Border Padding="32" MaxWidth="900">
      <a:Outlet />
    </Border>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a="https://aioros.dev" xmlns:m="using:Showcase.Models" xmlns:p="using:Showcase.Ports"
             xmlns:loader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia" x:DataType="m:PortModel">
  <StackPanel Spacing="28">
    <Border Classes="navlink" a:Web.Href="/ports" HorizontalAlignment="Left"><TextBlock Text="← Ported apps" /></Border>

    <StackPanel Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Classes="eyebrow" Text="{Binding Kind}" />
      <TextBlock Classes="display" Text="{Binding Name}" />
      <TextBlock Classes="lead" Text="{Binding Summary}" />
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
        <Border Classes="cta" a:Web.Href="{Binding WebUrl}" IsVisible="{Binding HasWebUrl}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Open the Aioros web version" VerticalAlignment="Center" />
            <a:Icon Kind="arrow-right" Size="16" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Classes="navlink" a:Web.Href="{Binding SourceUrl}" VerticalAlignment="Center">
          <TextBlock Text="The original's source" />
        </Border>
      </StackPanel>
      <TextBlock Classes="muted small wrap" Text="{Binding RunIt}" IsVisible="{Binding NoWebUrl}" />
    </StackPanel>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="20" a:Web.StackBelow="900">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="The original" />
        <Border Classes="card" Padding="0" ClipToBounds="True">
          <Image loader:ImageLoader.Source="{Binding OriginalImage}" AutomationProperties.Name="The original app" />
        </Border>
        <TextBlock Classes="muted small wrap" Text="{Binding OriginalCaption}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="10">
        <TextBlock Classes="h2" Text="On Aioros, in the browser" />
        <Border Classes="card" Padding="0" ClipToBounds="True">
          <Image loader:ImageLoader.Source="{Binding AiorosImage}" AutomationProperties.Name="The port in the browser" />
        </Border>
        <TextBlock Classes="muted small wrap" Text="{Binding AiorosCaption}" />
      </StackPanel>
    </Grid>

    <StackPanel Spacing="12">
      <TextBlock Classes="h1" Text="What the port changed" />
      <TextBlock Classes="muted wrap" Text="{Binding Source}" />
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="2*,2*,5*" ColumnSpacing="16">
            <TextBlock Classes="muted small" Text="Part" />
            <TextBlock Grid.Column="1" Classes="muted small" Text="Lines" />
            <TextBlock Grid.Column="2" Classes="muted small" Text="What" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Changes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="p:PortChange">
                <Grid ColumnDefinitions="2*,2*,5*" ColumnSpacing="16" Margin="0,6">
                  <TextBlock Text="{Binding Part}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding Lines}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" Classes="muted" Text="{Binding What}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <StackPanel Spacing="4">
        <TextBlock Text="Unchanged" FontWeight="SemiBold" />
        <TextBlock Classes="muted wrap" Text="{Binding Unchanged}" />
      </StackPanel>
    </StackPanel>

    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20" a:Web.StackBelow="900">
      <StackPanel Spacing="6">
        <a:Icon Kind="globe" Size="20" Foreground="{DynamicResource Accent}" />
        <TextBlock Text="On the web" FontWeight="SemiBold" />
        <TextBlock Classes="muted wrap small" Text="{Binding Web}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="6">
        <a:Icon Kind="monitor" Size="20" Foreground="{DynamicResource Accent}" />
        <TextBlock Text="Native" FontWeight="SemiBold" />
        <TextBlock Classes="muted wrap small" Text="{Binding Native}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="6">
        <a:Icon Kind="zap" Size="20" Foreground="{DynamicResource Accent}" />
        <TextBlock Text="Precompiled to render plans" FontWeight="SemiBold" />
        <TextBlock Classes="muted wrap small" Text="{Binding Precompiled}" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
